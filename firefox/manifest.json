{
  "manifest_version": 3,
  "name": "CadúnicoSLZ",
  "version": "0.3.1",
  "description": "Registra o histórico completo do atendimento no Cadastro Único, preservando a jornada e as respostas do sistema.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cadunicoslz@semcas.saoluis.ma.gov.br",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "healthInfo",
          "financialAndPaymentInfo",
          "authenticationInfo"
        ]
      }
    }
  },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://cadunico.dataprev.gov.br/*",
    "https://vxinqteushefztszmhdb.supabase.co/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://cadunico.dataprev.gov.br/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://cadunico.dataprev.gov.br/*"],
      "js": ["sandbox.js"],
      "run_at": "document_idle"
    }
  ]
}
