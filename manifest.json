{
  "manifest_version": 3,
  "name": "CadúnicoSLZ",
  "version": "0.6.15",
  "description": "Registra o histórico completo do atendimento no Cadastro Único, preservando a jornada e as respostas do sistema.",
  "permissions": ["storage", "tabs", "alarms", "management", "notifications"],
  "host_permissions": [
    "https://cadunico.dataprev.gov.br/*",
    "https://vxinqteushefztszmhdb.supabase.co/*",
    "https://form.jotform.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cadunico.dataprev.gov.br/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://cadunico.dataprev.gov.br/*"],
      "js": ["sandbox.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cadunico.dataprev.gov.br/*"],
      "js": ["visita.js"],
      "css": ["visita.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://form.jotform.com/*"],
      "js": ["jotform-cpf.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.jotform.com/form-widgets/cpf-validator/*"],
      "js": ["cpf-widget.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
